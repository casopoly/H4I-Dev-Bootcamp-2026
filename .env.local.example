# create local copy of this file and rename to .env.local
# make sure to add .env.local to .gitignore!!

# IMPORTANT: keep "/team14" before the "?". Without it the app connects to the empty default "test" database and shows no data.
# Replace <username> and <password> with the real values (ask Caleb offline). URL-encode special characters in the password.
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.wlsrcur.mongodb.net/team14?appName=Cluster0"

# Password for the /admin pages. Choose your own value in .env.local (ask Caleb offline for the team password).
ADMIN_PASSWORD=<choose-a-password>
